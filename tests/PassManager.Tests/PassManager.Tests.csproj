<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>PassManager.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- xUnit v3 on Microsoft.Testing.Platform (opted in via global.json). -->
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PassManager.Core\PassManager.Core.csproj" />
    <ProjectReference Include="..\..\src\PassManager.Infrastructure\PassManager.Infrastructure.csproj" />
  </ItemGroup>

</Project>
