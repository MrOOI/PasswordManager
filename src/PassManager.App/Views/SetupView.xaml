<UserControl x:Class="PassManager.App.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PassManager.App.ViewModels"
             xmlns:helpers="clr-namespace:PassManager.App.Helpers"
             xmlns:controls="clr-namespace:PassManager.App.Views.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SetupViewModel}"
             d:DesignWidth="1100" d:DesignHeight="720">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <ContentControl Style="{StaticResource Card.Elevated}" Width="460" Padding="40,36"
                        Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <Image Source="{StaticResource Image.Logo}" Width="60" Height="60" HorizontalAlignment="Center" />
                <TextBlock Text="Create your vault" Style="{StaticResource Text.Heading}" Margin="0,18,0,6" HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource Text.Secondary}" TextAlignment="Center" FontSize="14"
                           Text="Choose a master password. It encrypts everything in your vault and is the only key that can open it." />

                <TextBlock Text="Master password" Style="{StaticResource Text.FieldLabel}" Margin="0,24,0,6" />
                <PasswordBox x:Name="PasswordInput"
                             AutomationProperties.Name="Master password"
                             helpers:InputHelper.FocusOnLoad="True"
                             helpers:InputHelper.Placeholder="At least 12 characters — a passphrase works best"
                             helpers:PasswordBoxAssist.SecurePassword="{Binding Password, Mode=OneWayToSource}"
                             IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                <controls:StrengthMeter Result="{Binding Strength}" Margin="0,10,0,0" />

                <TextBlock Text="Confirm master password" Style="{StaticResource Text.FieldLabel}" />
                <PasswordBox AutomationProperties.Name="Confirm master password"
                             helpers:InputHelper.Placeholder="Type it again"
                             helpers:PasswordBoxAssist.SecurePassword="{Binding Confirmation, Mode=OneWayToSource}" />

                <Border Margin="0,20,0,0" Padding="14,12" CornerRadius="8"
                        Background="{StaticResource Brush.WarningSubtle}" BorderBrush="{StaticResource Brush.WarningBorder}" BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Text.Glyph}" VerticalAlignment="Top"
                                   Foreground="{StaticResource Brush.Warning}" Margin="0,2,10,0" />
                        <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource Brush.Warning}"
                                   Text="There is no way to recover a forgotten master password. Your data never leaves this computer, so nobody — including us — can reset it." />
                    </DockPanel>
                </Border>

                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" Margin="0,14,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource ValueToVisible}}" />

                <Grid Margin="0,22,0,0">
                    <Button Style="{StaticResource Button.Primary}" Command="{Binding CreateVaultCommand}" IsDefault="True"
                            HorizontalAlignment="Stretch" MinHeight="42" Content="Create vault" />
                    <controls:BusyIndicator HorizontalAlignment="Right" Margin="0,0,14,0"
                                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
                </Grid>

                <TextBlock Style="{StaticResource Text.Secondary}" FontSize="11.5" TextAlignment="Center" Margin="0,18,0,0"
                           Text="Protected with Argon2id key derivation and AES-256-GCM encryption." />
            </StackPanel>
        </ContentControl>
    </ScrollViewer>
</UserControl>
