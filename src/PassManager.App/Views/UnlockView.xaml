<UserControl x:Class="PassManager.App.Views.UnlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PassManager.App.ViewModels"
             xmlns:helpers="clr-namespace:PassManager.App.Helpers"
             xmlns:controls="clr-namespace:PassManager.App.Views.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:UnlockViewModel}"
             d:DesignWidth="1100" d:DesignHeight="720">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <ContentControl Style="{StaticResource Card.Elevated}" Width="420" Padding="40,36"
                            Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Image Source="{StaticResource Image.Logo}" Width="60" Height="60" HorizontalAlignment="Center" />
                    <TextBlock Text="Welcome back" Style="{StaticResource Text.Heading}" Margin="0,18,0,6" HorizontalAlignment="Center" />
                    <TextBlock Text="Enter your master password to unlock your vault."
                               Style="{StaticResource Text.Secondary}" FontSize="14" TextAlignment="Center" />

                    <Border Margin="0,18,0,0" Padding="12,9" CornerRadius="8"
                            Background="{StaticResource Brush.AccentSubtle}" BorderBrush="{StaticResource Brush.AccentSubtleBorder}" BorderThickness="1"
                            Visibility="{Binding InfoMessage, Converter={StaticResource ValueToVisible}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE72E;" Style="{StaticResource Text.Glyph}" FontSize="13"
                                       Foreground="{StaticResource Brush.Accent}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding InfoMessage}" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource Brush.AccentPressed}" />
                        </DockPanel>
                    </Border>

                    <TextBlock Text="Master password" Style="{StaticResource Text.FieldLabel}" Margin="0,22,0,6" />
                    <PasswordBox x:Name="PasswordInput"
                                 AutomationProperties.Name="Master password"
                                 helpers:InputHelper.FocusOnLoad="True"
                                 helpers:InputHelper.Placeholder="Master password"
                                 helpers:PasswordBoxAssist.SecurePassword="{Binding Password, Mode=OneWayToSource}"
                                 IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" Margin="0,10,0,0"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource ValueToVisible}}" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,6,0,0"
                               Visibility="{Binding IsCoolingDown, Converter={StaticResource BoolToVisible}}"
                               Text="{Binding CooldownSecondsRemaining, StringFormat='Too many attempts. Try again in {0} s.'}" />

                    <Grid Margin="0,20,0,0">
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding UnlockCommand}" IsDefault="True" AutomationProperties.Name="Unlock"
                                HorizontalAlignment="Stretch" MinHeight="42">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE785;" Style="{StaticResource Text.Glyph}" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Unlock" />
                            </StackPanel>
                        </Button>
                        <controls:BusyIndicator HorizontalAlignment="Right" Margin="0,0,14,0"
                                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
                    </Grid>

                    <TextBlock Style="{StaticResource Text.Secondary}" FontSize="11.5" TextAlignment="Center" Margin="0,22,0,0"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               ToolTip="{Binding VaultLocation}"
                               Text="{Binding VaultLocation, StringFormat='Vault: {0}'}" />
                </StackPanel>
            </ContentControl>
        </ScrollViewer>
    </Grid>
</UserControl>
