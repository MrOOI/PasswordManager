<Window x:Class="PassManager.App.Views.MessageDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PassManager.App.ViewModels"
        xmlns:helpers="clr-namespace:PassManager.App.Helpers"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MessageDialogViewModel}"
        Style="{StaticResource Window.Dialog}"
        Title="{Binding WindowTitle}" AutomationProperties.Name="{Binding WindowTitle}" Width="460">
    <Grid Margin="28,26,28,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Width="40" Height="40" CornerRadius="20" VerticalAlignment="Top" Margin="0,0,16,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource Brush.AccentSubtle}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Accent}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.DangerSubtle}" />
                            <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Danger}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Text.Glyph}" FontSize="17" HorizontalAlignment="Center" />
        </Border>

        <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" FontSize="17" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Secondary}" FontSize="14" Margin="0,8,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
            <Button Content="{Binding CancelText}" IsCancel="True" Command="{Binding CancelCommand}" MinWidth="96"
                    helpers:InputHelper.FocusOnLoad="{Binding IsDestructive}"
                    Visibility="{Binding HasCancel, Converter={StaticResource BoolToVisible}}" />
            <Button Content="{Binding ConfirmText}" IsDefault="True" Command="{Binding ConfirmCommand}" MinWidth="96" Margin="10,0,0,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.Danger}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
