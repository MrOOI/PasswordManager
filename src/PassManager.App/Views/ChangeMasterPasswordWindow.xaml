<Window x:Class="PassManager.App.Views.ChangeMasterPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PassManager.App.ViewModels"
        xmlns:helpers="clr-namespace:PassManager.App.Helpers"
        xmlns:controls="clr-namespace:PassManager.App.Views.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ChangeMasterPasswordViewModel}"
        Style="{StaticResource Window.Dialog}"
        Title="{Binding WindowTitle}" AutomationProperties.Name="{Binding WindowTitle}" Width="500">
    <StackPanel Margin="30,24,30,26">
        <TextBlock Text="Change master password" Style="{StaticResource Text.Title}" />
        <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,4,0,0"
                   Text="Your vault will be re-encrypted with a brand-new key. Copies encrypted with the old password are removed." />

        <TextBlock Text="Current master password" Style="{StaticResource Text.FieldLabel}" Margin="0,20,0,6" />
        <PasswordBox helpers:PasswordBoxAssist.SecurePassword="{Binding CurrentPassword, Mode=OneWayToSource}"
                     helpers:InputHelper.FocusOnLoad="True" AutomationProperties.Name="Current master password"
                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

        <TextBlock Text="New master password" Style="{StaticResource Text.FieldLabel}" />
        <PasswordBox helpers:PasswordBoxAssist.SecurePassword="{Binding NewPassword, Mode=OneWayToSource}"
                     helpers:InputHelper.Placeholder="At least 12 characters" AutomationProperties.Name="New master password"
                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
        <controls:StrengthMeter Result="{Binding Strength}" Margin="0,10,0,0" />

        <TextBlock Text="Confirm new master password" Style="{StaticResource Text.FieldLabel}" />
        <PasswordBox helpers:PasswordBoxAssist.SecurePassword="{Binding Confirmation, Mode=OneWayToSource}"
                     AutomationProperties.Name="Confirm new master password"
                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" Margin="0,12,0,0"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource ValueToVisible}}" />

        <Grid Margin="0,24,0,0">
            <controls:BusyIndicator HorizontalAlignment="Left" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Command="{Binding CancelCommand}" MinWidth="100" />
                <Button Content="Change password" Style="{StaticResource Button.Primary}" IsDefault="True"
                        Command="{Binding ChangeCommand}" MinWidth="140" Margin="10,0,0,0" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
