<Window x:Class="PassManager.App.Views.PasswordGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PassManager.App.ViewModels"
        xmlns:controls="clr-namespace:PassManager.App.Views.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:PasswordGeneratorViewModel}"
        Style="{StaticResource Window.Dialog}"
        Title="{Binding WindowTitle}" AutomationProperties.Name="{Binding WindowTitle}" Width="540">
    <StackPanel Margin="30,24,30,26">
        <TextBlock Text="Password generator" Style="{StaticResource Text.Title}" />
        <TextBlock Text="Passwords are created with the operating system's cryptographically secure random generator."
                   Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />

        <Border Margin="0,18,0,0" Padding="16,12,8,12" CornerRadius="10"
                Background="{StaticResource Brush.SurfaceAlt}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Style="{StaticResource TextBox.Display}" Text="{Binding GeneratedPassword, Mode=OneWay}"
                         FontFamily="{StaticResource Font.Mono}" FontSize="17" VerticalAlignment="Center"
                         AutomationProperties.Name="Generated password" />
                <Button Grid.Column="1" Style="{StaticResource Button.Icon}" Content="&#xE72C;"
                        Command="{Binding RegenerateCommand}" ToolTip="Generate another" AutomationProperties.Name="Regenerate" />
                <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Content="&#xE8C8;"
                        Command="{Binding CopyCommand}" ToolTip="Copy to clipboard" AutomationProperties.Name="Copy" />
            </Grid>
        </Border>
        <controls:StrengthMeter Result="{Binding Strength}" Margin="0,12,0,0" />
        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Secondary}" Foreground="{StaticResource Brush.Success}"
                   Margin="0,6,0,0" Visibility="{Binding StatusMessage, Converter={StaticResource ValueToVisible}}" />

        <DockPanel Margin="0,18,0,6">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Length}" FontWeight="SemiBold" />
            <TextBlock Text="Length" FontWeight="SemiBold" />
        </DockPanel>
        <Slider Minimum="{Binding MinimumLength}" Maximum="{Binding MaximumLength}" Value="{Binding Length}"
                IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="4"
                AutomationProperties.Name="Length" />

        <UniformGrid Columns="2" Margin="0,14,0,0">
            <CheckBox Content="Uppercase (A–Z)" IsChecked="{Binding IncludeUppercase}" />
            <CheckBox Content="Lowercase (a–z)" IsChecked="{Binding IncludeLowercase}" />
            <CheckBox Content="Digits (0–9)" IsChecked="{Binding IncludeDigits}" />
            <CheckBox Content="Symbols (!@#$…)" IsChecked="{Binding IncludeSymbols}" />
        </UniformGrid>
        <CheckBox Content="Avoid look-alike characters (I l 1 O 0 o)" IsChecked="{Binding ExcludeAmbiguous}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Close" IsCancel="True" Command="{Binding DismissCommand}" MinWidth="100" />
            <Button Content="Use password" Style="{StaticResource Button.Primary}" IsDefault="True"
                    Command="{Binding UsePasswordCommand}" MinWidth="120" Margin="10,0,0,0"
                    Visibility="{Binding IsSelectionMode, Converter={StaticResource BoolToVisible}}" />
        </StackPanel>
    </StackPanel>
</Window>
