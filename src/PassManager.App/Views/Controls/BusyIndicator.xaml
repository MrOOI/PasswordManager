<UserControl x:Class="PassManager.App.Views.Controls.BusyIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="20" Height="20" Focusable="False" IsHitTestVisible="False">
    <Grid>
        <Ellipse Stroke="{StaticResource Brush.Border}" StrokeThickness="2.5" />
        <Path Data="M 10,1.25 A 8.75,8.75 0 0 1 18.75,10" Stroke="{StaticResource Brush.Accent}" StrokeThickness="2.5"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform>
                <RotateTransform />
            </Path.RenderTransform>
            <Path.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                             From="0" To="360" Duration="0:0:0.9" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Path.Triggers>
        </Path>
    </Grid>
</UserControl>
