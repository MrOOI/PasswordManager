<UserControl x:Class="PassManager.App.Views.Controls.StrengthMeter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PassManager.App.Views.Controls"
             Focusable="False">
    <StackPanel DataContext="{Binding Result, RelativeSource={RelativeSource AncestorType={x:Type local:StrengthMeter}}}">
        <ProgressBar Style="{StaticResource ProgressBar.Strength}"
                     Value="{Binding Converter={StaticResource StrengthToMeterValue}, Mode=OneWay}"
                     Foreground="{Binding Converter={StaticResource StrengthToBrush}}"
                     AutomationProperties.Name="Password strength" />
        <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{StaticResource Brush.TextSecondary}"
                   Text="{Binding Converter={StaticResource StrengthToText}}" />
    </StackPanel>
</UserControl>
