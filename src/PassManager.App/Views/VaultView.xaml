<UserControl x:Class="PassManager.App.Views.VaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PassManager.App.ViewModels"
             xmlns:helpers="clr-namespace:PassManager.App.Helpers"
             xmlns:controls="clr-namespace:PassManager.App.Views.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:VaultViewModel}"
             d:DesignWidth="1180" d:DesignHeight="740">

    <UserControl.InputBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding AddEntryCommand}" />
        <KeyBinding Gesture="Ctrl+E" Command="{Binding EditEntryCommand}" />
        <KeyBinding Gesture="Ctrl+L" Command="{Binding LockCommand}" />
        <KeyBinding Gesture="Ctrl+G" Command="{Binding OpenGeneratorCommand}" />
        <KeyBinding Gesture="Ctrl+B" Command="{Binding CopyUsernameCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+C" Command="{Binding CopyPasswordCommand}" />
        <KeyBinding Gesture="Ctrl+U" Command="{Binding OpenUrlCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Sidebar ============ -->
        <Grid Background="{StaticResource Brush.Sidebar}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="22,22,20,22">
                <Image Source="{StaticResource Image.Logo}" Width="30" Height="30" />
                <TextBlock Text="PassManager" Foreground="White" FontSize="17" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="11,0,0,0" />
            </StackPanel>

            <DockPanel Grid.Row="1">
                <TextBlock DockPanel.Dock="Top" Text="VAULT" Style="{StaticResource Text.SidebarHeader}" Margin="24,4,0,8" />
                <ListBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}"
                         Style="{StaticResource ListBox.Plain}" ItemContainerStyle="{StaticResource ListBoxItem.Sidebar}"
                         AutomationProperties.Name="Filters">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:EntryFilterViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Text.Glyph}" FontSize="14" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="12" Opacity="0.65" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <StackPanel Grid.Row="2" Margin="10,8,10,18">
                <Border Height="1" Background="{StaticResource Brush.SidebarHover}" Margin="12,0,12,10" />
                <Button Style="{StaticResource Button.Sidebar}" Command="{Binding OpenGeneratorCommand}" ToolTip="Password generator (Ctrl+G)" AutomationProperties.Name="Password generator">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B1;" Style="{StaticResource Text.Glyph}" FontSize="14" Width="28" />
                        <TextBlock Text="Password generator" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Sidebar}" Command="{Binding ChangeMasterPasswordCommand}" AutomationProperties.Name="Change master password">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8D7;" Style="{StaticResource Text.Glyph}" FontSize="14" Width="28" />
                        <TextBlock Text="Master password" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Sidebar}" Command="{Binding OpenSettingsCommand}" AutomationProperties.Name="Settings">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" Style="{StaticResource Text.Glyph}" FontSize="14" Width="28" />
                        <TextBlock Text="Settings" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Sidebar}" Command="{Binding LockCommand}" ToolTip="Lock vault (Ctrl+L)" AutomationProperties.Name="Lock vault">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;" Style="{StaticResource Text.Glyph}" FontSize="14" Width="28" />
                        <TextBlock Text="Lock vault" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============ Entry list ============ -->
        <Border Grid.Column="1" Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="18,20,18,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="SearchBox" Padding="34,8,10,8"
                                 AutomationProperties.Name="Search"
                                 helpers:InputHelper.Placeholder="Search (Ctrl+F)"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=120}" />
                        <TextBlock Text="&#xE721;" Style="{StaticResource Text.Glyph}" FontSize="13" Margin="13,0,0,0"
                                   HorizontalAlignment="Left" IsHitTestVisible="False" Foreground="{StaticResource Brush.TextTertiary}" />
                    </Grid>
                    <Button Grid.Column="1" Style="{StaticResource Button.Primary}" Command="{Binding AddEntryCommand}"
                            ToolTip="New entry (Ctrl+N)" AutomationProperties.Name="New entry"
                            Margin="10,0,0,0" Padding="0" Width="40" Height="40">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Text.Glyph}" FontSize="14" />
                    </Button>
                </Grid>

                <DockPanel Grid.Row="1" Margin="22,2,22,8">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding VisibleCountText}" Style="{StaticResource Text.Secondary}" />
                    <TextBlock Text="{Binding SelectedFilter.Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <ListBox x:Name="EntryList" Grid.Row="2" Style="{StaticResource ListBox.Plain}"
                         ItemContainerStyle="{StaticResource ListBoxItem.Entry}"
                         ItemsSource="{Binding EntriesView}" SelectedItem="{Binding SelectedEntry}"
                         AutomationProperties.Name="Entries" Padding="0,0,0,12">
                    <ListBox.InputBindings>
                        <KeyBinding Key="Delete" Command="{Binding DeleteEntryCommand}" />
                        <KeyBinding Key="Enter" Command="{Binding EditEntryCommand}" />
                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditEntryCommand}" />
                    </ListBox.InputBindings>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:EntryItemViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="9" Background="{Binding Title, Converter={StaticResource AvatarBrush}}">
                                    <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="SemiBold" FontSize="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{StaticResource Brush.TextSecondary}"
                                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="&#xE735;" Style="{StaticResource Text.Glyph}" FontSize="13"
                                           Foreground="{StaticResource Brush.Favorite}"
                                           Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisible}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32"
                            Visibility="{Binding IsListEmpty, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Text="&#xE721;" Style="{StaticResource Text.Glyph}" FontSize="30" HorizontalAlignment="Center"
                               Foreground="{StaticResource Brush.TextTertiary}" />
                    <TextBlock Text="{Binding EmptyListMessage}" Style="{StaticResource Text.Secondary}" FontSize="13.5"
                               TextAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Details ============ -->
        <Grid Grid.Column="2">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding SelectedEntry, Converter={StaticResource ValueToCollapsed}}">
                <Image Source="{StaticResource Image.Logo}" Width="56" Height="56" Opacity="0.25" />
                <TextBlock Text="Select an entry to see its details" Style="{StaticResource Text.Secondary}" FontSize="14"
                           HorizontalAlignment="Center" Margin="0,14,0,0" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"
                          Visibility="{Binding SelectedEntry, Converter={StaticResource ValueToVisible}}">
                <StackPanel Margin="36,30,36,36" MaxWidth="760">

                    <!-- Header -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="56" Height="56" CornerRadius="13"
                                Background="{Binding SelectedEntry.Title, Converter={StaticResource AvatarBrush}}">
                            <TextBlock Text="{Binding SelectedEntry.Initial}" Foreground="White" FontWeight="SemiBold" FontSize="24"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedEntry.Title}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <Border HorizontalAlignment="Left" Margin="0,5,0,0" Padding="9,2" CornerRadius="10"
                                    Background="{StaticResource Brush.Hover}"
                                    Visibility="{Binding SelectedEntry.HasCategory, Converter={StaticResource BoolToVisible}}">
                                <TextBlock Text="{Binding SelectedEntry.Category}" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Button.Icon}" Command="{Binding ToggleFavoriteCommand}"
                                    ToolTip="Toggle favorite" AutomationProperties.Name="Toggle favorite">
                                <Grid>
                                    <TextBlock Text="&#xE734;" Visibility="{Binding SelectedEntry.IsFavorite, Converter={StaticResource BoolToCollapsed}}" />
                                    <TextBlock Text="&#xE735;" Foreground="{StaticResource Brush.Favorite}"
                                               Visibility="{Binding SelectedEntry.IsFavorite, Converter={StaticResource BoolToVisible}}" />
                                </Grid>
                            </Button>
                            <Button Command="{Binding EditEntryCommand}" Margin="8,0,0,0" ToolTip="Edit (Ctrl+E)" AutomationProperties.Name="Edit entry">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70F;" Style="{StaticResource Text.Glyph}" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="Edit" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding DeleteEntryCommand}" Margin="8,0,0,0" ToolTip="Delete (Del)" AutomationProperties.Name="Delete entry"
                                    Foreground="{StaticResource Brush.Danger}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Text.Glyph}" FontSize="13" Margin="0,0,8,0" />
                                    <TextBlock Text="Delete" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Credentials -->
                    <Border Style="{StaticResource Card}" Padding="22,6" Margin="0,26,0,0">
                        <StackPanel>
                            <Grid Margin="0,12" Visibility="{Binding SelectedEntry.HasUsername, Converter={StaticResource BoolToVisible}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Username" Style="{StaticResource Text.FieldLabel}" Margin="0,0,0,4" />
                                    <TextBox Style="{StaticResource TextBox.Display}" Text="{Binding SelectedEntry.Username, Mode=OneWay}"
                                             AutomationProperties.Name="Username" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource Button.Icon}" Content="&#xE8C8;"
                                        Command="{Binding CopyUsernameCommand}" ToolTip="Copy username (Ctrl+B)"
                                        AutomationProperties.Name="Copy username" VerticalAlignment="Center" />
                            </Grid>

                            <Border Height="1" Background="{StaticResource Brush.Border}"
                                    Visibility="{Binding SelectedEntry.HasUsername, Converter={StaticResource BoolToVisible}}" />

                            <Grid Margin="0,12" Visibility="{Binding SelectedEntry.HasPassword, Converter={StaticResource BoolToVisible}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Password" Style="{StaticResource Text.FieldLabel}" Margin="0,0,0,4" />
                                    <TextBox Style="{StaticResource TextBox.Display}" FontFamily="{StaticResource Font.Mono}"
                                             Text="{Binding SelectedPasswordDisplay, Mode=OneWay}" AutomationProperties.Name="Password" />
                                    <controls:StrengthMeter Result="{Binding SelectedPasswordStrength}" Width="340"
                                                            HorizontalAlignment="Left" Margin="0,10,0,0" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" Style="{StaticResource ToggleButton.Icon}" Content="&#xE7B3;"
                                              IsChecked="{Binding IsPasswordRevealed}" ToolTip="Show or hide password"
                                              AutomationProperties.Name="Reveal password" VerticalAlignment="Top" Margin="0,14,0,0" />
                                <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Content="&#xE8C8;"
                                        Command="{Binding CopyPasswordCommand}" ToolTip="Copy password (Ctrl+Shift+C)"
                                        AutomationProperties.Name="Copy password" VerticalAlignment="Top" Margin="4,14,0,0" />
                            </Grid>

                            <Border Height="1" Background="{StaticResource Brush.Border}"
                                    Visibility="{Binding SelectedEntry.HasUrl, Converter={StaticResource BoolToVisible}}" />

                            <Grid Margin="0,12" Visibility="{Binding SelectedEntry.HasUrl, Converter={StaticResource BoolToVisible}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Website" Style="{StaticResource Text.FieldLabel}" Margin="0,0,0,4" />
                                    <TextBox Style="{StaticResource TextBox.Display}" Text="{Binding SelectedEntry.Url, Mode=OneWay}"
                                             Foreground="{StaticResource Brush.Accent}" AutomationProperties.Name="Website" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource Button.Icon}" Content="&#xE8A7;"
                                        Command="{Binding OpenUrlCommand}" ToolTip="Open in browser (Ctrl+U)"
                                        AutomationProperties.Name="Open website" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Content="&#xE8C8;"
                                        Command="{Binding CopyUrlCommand}" ToolTip="Copy website"
                                        AutomationProperties.Name="Copy website" VerticalAlignment="Center" Margin="4,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Notes -->
                    <Border Style="{StaticResource Card}" Padding="22,16" Margin="0,16,0,0"
                            Visibility="{Binding SelectedEntry.HasNotes, Converter={StaticResource BoolToVisible}}">
                        <StackPanel>
                            <TextBlock Text="Notes" Style="{StaticResource Text.FieldLabel}" Margin="0,0,0,6" />
                            <TextBox Style="{StaticResource TextBox.Display}" Text="{Binding SelectedEntry.Notes, Mode=OneWay}"
                                     AcceptsReturn="True" FontSize="14" AutomationProperties.Name="Notes" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding SelectedEntry.Timestamps}" Style="{StaticResource Text.Secondary}" FontSize="12" Margin="2,16,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============ Status toast ============ -->
        <Border Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26"
                Padding="18,11" CornerRadius="10" Background="{StaticResource Brush.Toast}" IsHitTestVisible="False"
                Visibility="{Binding StatusMessage, Converter={StaticResource ValueToVisible}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" Opacity="0.25" ShadowDepth="4" Direction="270" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE930;" Style="{StaticResource Text.Glyph}" FontSize="14" Foreground="#4ADE80" Margin="0,0,10,0" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="13.5" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
