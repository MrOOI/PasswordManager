<Window x:Class="PassManager.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PassManager.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Style="{StaticResource Window.Dialog}"
        Title="{Binding WindowTitle}" AutomationProperties.Name="{Binding WindowTitle}" Width="560">
    <StackPanel Margin="30,24,30,26">
        <TextBlock Text="Settings" Style="{StaticResource Text.Title}" />

        <TextBlock Text="SECURITY" Style="{StaticResource Text.FieldLabel}" FontSize="11" Margin="0,20,0,4" />
        <Grid Margin="0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="210" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Lock the vault when idle" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding AutoLockOptions}" SelectedItem="{Binding SelectedAutoLock}"
                      DisplayMemberPath="Label" AutomationProperties.Name="Auto-lock" />
        </Grid>
        <Grid Margin="0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="210" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Clear copied passwords from the clipboard" VerticalAlignment="Center" TextWrapping="Wrap" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding ClipboardOptions}" SelectedItem="{Binding SelectedClipboardClear}"
                      DisplayMemberPath="Label" AutomationProperties.Name="Clipboard clearing" />
        </Grid>
        <CheckBox Content="Lock when Windows is locked or the computer sleeps" IsChecked="{Binding LockOnSessionLock}" Margin="0,10,0,4" />
        <CheckBox Content="Lock when the window is minimized" IsChecked="{Binding LockOnMinimize}" />
        <CheckBox IsChecked="{Binding HideFromScreenCapture}">
            <TextBlock TextWrapping="Wrap" Text="Hide PassManager windows from screenshots, recordings and screen sharing" />
        </CheckBox>

        <TextBlock Text="STORAGE" Style="{StaticResource Text.FieldLabel}" FontSize="11" Margin="0,22,0,6" />
        <Border Padding="14,10" CornerRadius="8" Background="{StaticResource Brush.SurfaceAlt}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Encrypted vault file" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="{Binding VaultLocation}" Style="{StaticResource Text.Secondary}" FontSize="12"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding VaultLocation}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Show in Explorer" Command="{Binding RevealVaultFileCommand}" Margin="12,0,0,0" />
            </Grid>
        </Border>
        <TextBlock Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,8,0,0"
                   Text="Back up this file regularly (e.g. to an external drive). It is useless without your master password." />

        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" Margin="0,12,0,0"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource ValueToVisible}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancel" IsCancel="True" Command="{Binding CancelCommand}" MinWidth="100" />
            <Button Content="Save" Style="{StaticResource Button.Primary}" IsDefault="True" Command="{Binding SaveCommand}"
                    MinWidth="100" Margin="10,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
