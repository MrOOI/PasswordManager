<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:PassManager.App.ViewModels"
                    xmlns:views="clr-namespace:PassManager.App.Views">

    <!-- ViewModel-first navigation: the shell's ContentControl picks the view by view model type. -->
    <DataTemplate DataType="{x:Type vm:SetupViewModel}">
        <views:SetupView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:UnlockViewModel}">
        <views:UnlockView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:VaultViewModel}">
        <views:VaultView />
    </DataTemplate>

</ResourceDictionary>
