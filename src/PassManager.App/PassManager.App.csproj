<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>PassManager</AssemblyName>
    <RootNamespace>PassManager.App</RootNamespace>
    <AssemblyTitle>PassManager</AssemblyTitle>
    <Description>Secure offline password manager</Description>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Required by the LibraryImport source generator (user32 interop). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\app.ico" Link="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PassManager.Core\PassManager.Core.csproj" />
    <ProjectReference Include="..\PassManager.Infrastructure\PassManager.Infrastructure.csproj" />
  </ItemGroup>

</Project>
